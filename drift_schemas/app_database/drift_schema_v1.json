  "fixed_sql": [
    {
      "name": "account_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"account_settings\" (\"id\" INTEGER NOT NULL, \"account_nickname\" TEXT NOT NULL, \"virtual_balance\" INTEGER NOT NULL DEFAULT 1000000000, \"currency_code\" TEXT NOT NULL DEFAULT 'KRW', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (length(trim(account_nickname)) > 0), CHECK (virtual_balance BETWEEN 0 AND 999999999999), CHECK (currency_code = 'KRW'), CHECK (created_at >= 0 AND updated_at >= 0));"
        }
      ]
    },
    {
      "name": "mood_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mood_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"mood_type\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, CHECK (mood_type IN ('tired', 'neutral', 'okay', 'happy')), CHECK (created_at >= 0));"
        }
      ]
    },
    {
      "name": "dream_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dream_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"estimated_cost\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (length(trim(title)) > 0), CHECK (estimated_cost IS NULL OR estimated_cost BETWEEN 0 AND 999999999999), CHECK (created_at >= 0 AND updated_at >= 0));"
        }
      ]
    },
    {
      "name": "future_letters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"future_letters\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"unlock_at\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, CHECK (length(trim(title)) > 0 AND length(trim(content)) > 0), CHECK (unlock_at IS NULL OR (length(unlock_at) = 10 AND unlock_at GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]')), CHECK (created_at >= 0 AND updated_at >= 0));"
        }
      ]
    },
    {
      "name": "mood_latest",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX mood_latest ON mood_entries (created_at, id)"
        }
      ]
    },
    {
      "name": "dream_recent",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX dream_recent ON dream_items (updated_at, id)"
        }
      ]
    },
    {
